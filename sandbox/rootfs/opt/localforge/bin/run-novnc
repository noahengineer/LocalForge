#!/bin/bash
# websockify bridge: ws://<container>:6080/websockify -> VNC on localhost:5901.
# Also serves the stock noVNC client at / for debugging in a browser.
for _ in $(seq 1 100); do
  (exec 3<>/dev/tcp/127.0.0.1/5901) 2>/dev/null && break
  sleep 0.1
done
exec websockify --web /usr/share/novnc 0.0.0.0:6080 127.0.0.1:5901
